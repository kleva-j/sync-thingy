{
  "name": "@sync-disc/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client-db": "./src/client-db.ts",
    "./client-migrations": "./src/client-migrations.ts",
    "./client-schema": "./src/client-schema.ts",
    "./migrations": "./src/migrations.generated.ts",
    "./repositories": "./src/repositories/index.ts",
    "./schema": "./src/schema.ts",
    "./server-schema": "./src/server-schema.ts",
    "./testing": "./src/testing/pglite.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "migrations:build": "node scripts/build-migrations.mjs drizzle/client src/migrations.generated.ts clientMigrations && oxfmt src/migrations.generated.ts",
    "migrations:check:client": "vp test tests/client-migrations.test.ts",
    "migrations:check:server": "node scripts/check-server-migrations.mjs",
    "migrations:generate": "pnpm run migrations:generate:client && pnpm run migrations:generate:server",
    "migrations:generate:client": "drizzle-kit generate --config=drizzle.client.config.ts && pnpm run migrations:build && oxfmt drizzle/client/meta",
    "migrations:generate:server": "drizzle-kit generate --config=drizzle.server.config.ts && oxfmt drizzle/server/meta",
    "test": "vp test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-sync": "0.6.11",
    "core": "workspace:*",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@sync-disc/config": "workspace:*",
    "@types/node": "^26.6.5",
    "drizzle-kit": "0.31.11",
    "effect": "catalog:",
    "pg": "^8.23.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
