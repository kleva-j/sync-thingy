{
  "name": "@sync-disc/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/spike-migrations.generated.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "migrations:build": "node scripts/build-migrations.mjs",
